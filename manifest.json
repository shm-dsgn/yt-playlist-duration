{
  "name": "YouTube Playlist Duration",
  "version": "1.2.2",
  "description": "Popup to show the duration of the YouTube playlist.",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "YouTube Playlist Duration",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ]
}